# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost

# Supabase
# Local dev:       http://127.0.0.1:54321 (via `npx supabase start`)
# Supabase Cloud:  https://<project-ref>.supabase.co
# Self-hosted VPS: https://supabase.seu-dominio.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=

# Crypto (>=32 chars — encripta tokens OAuth armazenados no banco)
ENCRYPTION_KEY=

# Cron
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=
# Resend webhook signing secret (svix-format). Configure em https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=

# Email Marketing (Amazon SES - optional)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Motor de voz IA (ligacoes inbound/outbound)
VOICE_ENGINE_API_KEY=
VOICE_ENGINE_WEBHOOK_SECRET=
VOICE_ENGINE_BASE_URL=

# Provedor de numeros DID BR
DID_PROVIDER_API_TOKEN=
DID_PROVIDER_BASE_URL=

# Modelo de linguagem (primario)
ANTHROPIC_API_KEY=

# Modelo de imagem (primario)
OPENAI_API_KEY=

# Modelo de imagem (fallback)
IMAGE_MODEL_FALLBACK_TOKEN=
IMAGE_MODEL_FALLBACK_URL=

# Together.ai — geracao de imagens (FLUX). Provider primario para social.
# Sem chave: o composer cai num placeholder (picsum). Com chave: imagens reais.
TOGETHER_API_KEY=

# Higgsfield — geracao de videos (motion). Em breve.
HIGGSFIELD_API_KEY=

# Servidor proprio de IA (futuro). Endpoint OpenAI-compatible.
# Quando definido, tem prioridade sobre Together/Higgsfield.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=

# Gerador de video legado (motion graphics templates)
VIDEO_GENERATOR_API_KEY=

# Meta Ads (Marketing API)
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Stripe (Billing internacional — opcional, usado apenas se PAYMENT_GATEWAY=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OPERACAO=
STRIPE_PRICE_CRESCIMENTO=
STRIPE_PRICE_ESCALA=

# Asaas (Billing BR — recomendado para PIX/Boleto/Cartao)
# https://docs.asaas.com — gera a chave em Painel → Integracoes → API
# Para sandbox use ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago (alternativa ao Asaas)
# https://www.mercadopago.com.br/developers — Production Access Token
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Gateway preferido para compra de creditos: asaas | mercadopago | stripe
# Se vazio, escolhe automaticamente baseado nas chaves disponiveis (asaas > mercadopago > stripe)
PAYMENT_GATEWAY=

# Social Media - LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Social Media - TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Social Media - YouTube (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limit (deixe vazio em prod; "1" desabilita em dev local)
RATE_LIMIT_DISABLED=

# Web Push (VAPID) — gere com `npx web-push generate-vapid-keys`
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Email Marketing — Resend webhook signing (svix format)
# Já incluído acima como RESEND_WEBHOOK_SECRET
